# Base de datos (Supabase → Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# JWT - generá una clave larga y aleatoria
JWT_SECRET=cambia_esto_por_una_clave_muy_larga_y_aleatoria

# Contraseña compartida para acceder al sistema
APP_PASSWORD=password123

# HMAC para firmar QR codes
QR_SECRET=otra_clave_secreta_para_qr

# Gmail (necesitás una App Password, no la contraseña normal)
GMAIL_USER=tuemail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Puerto (Railway lo setea automáticamente)
PORT=3001
